---
layout: default
---

<div class="home">
  {%- if page.title -%}
    <h1 class="page-heading">{{ page.title }}</h1>
  {%- endif -%}

  {{ content }}

  {%- if site.posts.size > 0 -%}
    <h2 class="post-list-heading">{{ page.list_title | default: "Posts" }}</h2>
    <ul class="post-list">
      {%- for post in site.posts -%}
      <li class="post-item">
        {%- if post.image -%}
        <a class="post-cover-link" href="{{ post.url | relative_url }}">
          <img class="post-cover" src="{{ post.image | relative_url }}" alt="{{ post.title | escape }}" loading="lazy">
        </a>
        {%- endif -%}

        <div class="post-content">
          {%- assign date_format = site.minima.date_format | default: "%b %-d, %Y" -%}
          <span class="post-meta">
            {{ post.date | date: date_format }}
          </span>
          <span class="post-meta">
            {%- for cat in post.categories -%}
            <a class="post-category" href="{{ '/categories/' | relative_url }}#{{ cat | slugify }}">{{ cat }}</a>
            {%- endfor -%}
          </span>
          <h3>
            <a class="post-link" href="{{ post.url | relative_url }}">
              {{ post.title | escape }}
            </a>
          </h3>
          <p class="post-excerpt">
            {{ post.excerpt | strip_html | strip_newlines | truncatewords: 35 }}
          </p>
          <a class="read-more" href="{{ post.url | relative_url }}">Leggi tutto →</a>
        </div>
      </li>
      {%- endfor -%}
    </ul>

    <p class="rss-subscribe">subscribe <a href="{{ "/feed.xml" | relative_url }}">via RSS</a></p>
  {%- endif -%}

</div>